# /etc/netbox-zabbix-sync/env — права 600, владелец root.
# Читается systemd (EnvironmentFile=), в репозиторий с реальными значениями не коммитить.
NETBOX_URL=https://netbox.example.local
NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567
ZABBIX_URL=https://zabbix.example.local
# Рекомендуется API-токен (Users -> API tokens) ...
ZABBIX_TOKEN=
# ... либо логин/пароль сервисной учётки
#ZABBIX_USER=svc-netbox-sync
#ZABBIX_PASSWORD=
# Секрет вебхука NetBox (только для режима serve)
NETBOX_WEBHOOK_SECRET=
NBZS_CONFIG=/etc/netbox-zabbix-sync/config.yaml
