[Unit]
Description=NetBox -> Zabbix device sync (one run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nbzs
Group=nbzs
EnvironmentFile=/etc/netbox-zabbix-sync/env
ExecStart=/opt/netbox-zabbix-sync/venv/bin/python /opt/netbox-zabbix-sync/netbox_zabbix_sync.py sync --non-interactive
RuntimeDirectory=netbox-zabbix-sync
StateDirectory=netbox-zabbix-sync
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
